# Neon connection string — get this from your Neon project's "Connect" panel.
# Use the pooled connection string for the app; a direct (unpooled) one is
# only needed for things like pg_dump/pg_restore.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# How long a login token stays valid
JWT_EXPIRES_IN="7d"

PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URLs)
CORS_ORIGIN="http://localhost:5173"
